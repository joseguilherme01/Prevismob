# ===========================================================================
# Exemplo de configuração — copie para ".env" e preencha com valores locais.
# Nunca commit do arquivo .env real.
# ===========================================================================

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- Banco de dados (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=prevismob

# --- JWT ---
JWT_SECRET_KEY=troque-para-valor-de-alta-entropia
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Separe origens por vírgula. Ex.: http://localhost:5173,https://prevismob.com
CORS_ORIGINS=

# ===========================================================================
# VERIFICAÇÃO DE E-MAIL
# ===========================================================================

# URL base pública da aplicação — usada para montar o link de verificação
# que é enviado no e-mail. Em produção: https://seu-dominio.com
APP_BASE_URL=http://localhost:8000

# Ambiente. Quando "production", logs mascaram o token.
APP_ENV=development

# Tempo de validade do token de verificação (horas).
EMAIL_VERIFY_TTL_HOURS=24

# Cooldown entre reenvios de verificação por usuário (minutos).
EMAIL_VERIFY_RESEND_COOLDOWN_MIN=2

# --- SMTP ---
# Se SMTP_HOST estiver vazio OU SMTP_DEV_MODE=1, a API entra em modo dev:
# o link de verificação é apenas logado (não dispara SMTP).
SMTP_DEV_MODE=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@prevismob.local
SMTP_USE_TLS=1
SMTP_USE_SSL=0
